# ==============================================================================
# Business Digital Twin - Environment Configuration Template
# Copy this file to .env and replace placeholder values with actual secrets.
# ==============================================================================

# Application Environment (Development, Staging, Production)
ENVIRONMENT=Production

# Database Configuration (PostgreSQL)
POSTGRES_DB=business_twin_db
POSTGRES_USER=twin_admin
POSTGRES_PASSWORD=YourSuperSecureDbPassword123!
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ASP.NET Core Database Connection String
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=business_twin_db;Username=twin_admin;Password=YourSuperSecureDbPassword123!;Include Error Detail=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YourSuperSecureRedisPassword123!
ConnectionStrings__Redis=redis:6379,password=YourSuperSecureRedisPassword123!,abortConnect=false

# JWT Authentication
Jwt__Secret=YourSuperSecretJwtSigningKeyMustBeAtLeast32BytesLong123456!
Jwt__Issuer=BusinessDigitalTwin
Jwt__Audience=BusinessDigitalTwinClient
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# Python AI & Analytics Service
AI_SERVICE_URL=http://ai-service:8000
AiService__BaseUrl=http://ai-service:8000
AiService__ApiKey=internal-secret-service-token-12345

# External LLM API Keys (Optional - Deterministic Statistical Engine runs automatically if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS Configuration (Comma-separated allowed origins)
Cors__AllowedOrigins=http://localhost:3000,http://localhost,https://yourdomain.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME="Business Digital Twin"
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Nginx & Domain Settings
DOMAIN_NAME=localhost
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
